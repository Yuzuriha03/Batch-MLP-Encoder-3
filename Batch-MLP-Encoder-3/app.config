<?xml version="1.0" encoding="utf-8"?>
<!--
  迁移到 .NET 10 后，本文件只剩下一个作用：给 Properties.Settings（ApplicationSettingsBase）
  提供 userSettings 段声明。其余 .NET Framework 专用配置都已删除：

    - <startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.2"/></startup>
      这是 .NET Framework 的 CLR 激活配置，.NET 10 根本不读取它。
    - <appSettings> 里的 EnableWindowsFormsHighDpiAutoResizing
      也是 .NET Framework 窗体专用，.NET 10 下已改为在 Program.Main 里调用
      Application.SetHighDpiMode(HighDpiMode.SystemAware)（见 Program.cs）。

  ⚠ configSections + userSettings 必须保留：
  删掉它们的话，ApplicationSettingsBase 读写 user.config 会报 ConfigurationErrorsException，
  用户的 Surcode/eac3to/临时文件夹/输出文件夹四个路径就存不下来了。
-->
<configuration>
<configSections>
    <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
        <section name="SadPencil.BatchMLPEncoder3.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false"/>
    </sectionGroup>
</configSections>
<userSettings>
        <SadPencil.BatchMLPEncoder3.Properties.Settings>
            <setting name="Eac3toExeFullname" serializeAs="String">
                <value/>
            </setting>
            <setting name="SurcodeExeFullname" serializeAs="String">
                <value/>
            </setting>
            <setting name="TempFolderPath" serializeAs="String">
                <value/>
            </setting>
            <setting name="OutputFolderPath" serializeAs="String">
                <value/>
            </setting>
        </SadPencil.BatchMLPEncoder3.Properties.Settings>
    </userSettings>
</configuration>
